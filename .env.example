# ==============================================================================
# NormaHub FastAPI AI Enterprise Starter - Environment Configuration
# ==============================================================================
# Получите единый API-ключ на платформе: https://normahub.cc
# Доступ к 30+ передовым моделям (Claude Sonnet 5.5, GPT-6 Astra, DeepSeek v4.1 Flash,
# GLM-5.3 Flash, SeeDance 2.5) без VPN, с оплатой через СБП, карты МИР и счета с НДС 20%.
# ==============================================================================

# [NormaHub API Configuration]
# Обязательный ключ доступа к шлюзу NormaHub
NORMAHUB_API_KEY=norma-sec-enterprise-your-api-key-here

# Базовый URL OpenAI-совместимого API NormaHub (по умолчанию: https://api.normahub.cc/v1)
NORMAHUB_BASE_URL=https://api.normahub.cc/v1

# Основная рабочая модель (например: gpt-6-astra, claude-sonnet-5-5, deepseek-v4.1-flash)
DEFAULT_MODEL=gpt-6-astra

# Резервная модель при срабатывании Circuit Breaker или таймаутах основного провайдера
FALLBACK_MODEL=claude-sonnet-5-5

# Модель векторных эмбеддингов для RAG и семантического кэша
EMBEDDING_MODEL=text-embedding-3-small

# [Server & Gateway Settings]
APP_NAME="NormaHub FastAPI Enterprise AI Gateway"
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# [Resilience & Circuit Breaker]
# Таймаут HTTP-запросов к LLM (в секундах)
GATEWAY_TIMEOUT_SECONDS=60.0

# Максимальное количество попыток повтора при ошибках 429/502/503/504
GATEWAY_MAX_RETRIES=3

# Базовое время экспоненциального отката (в секундах)
GATEWAY_BACKOFF_FACTOR=1.5

# Порог последовательных ошибок для размыкания Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5

# Время нахождения в состоянии OPEN до пробного запроса HALF-OPEN (в секундах)
CIRCUIT_BREAKER_RECOVERY_SECONDS=30.0

# [Semantic Cache & Redis]
# URL подключения к Redis. Если недоступен или пуст, используется In-Memory LRU кэш
REDIS_URL=redis://localhost:6379/0

# Порог косинусного сходства векторов для попадания в кэш (0.0 - 1.0)
# 0.92 обеспечивает баланс между точностью ответа и экономией до 70% токенов
CACHE_SIMILARITY_THRESHOLD=0.92

# Время жизни кэшированных ответов в секундах (86400 = 24 часа)
CACHE_TTL_SECONDS=86400

# Максимальный размер In-Memory кэша в элементах
MEMORY_CACHE_MAX_SIZE=5000

# [Hybrid RAG Configuration]
# Вес плотного векторного поиска в гибридной оценке RRF (0.0 - 1.0)
RAG_VECTOR_WEIGHT=0.7

# Вес лексического поиска BM25 в гибридной оценке (0.0 - 1.0)
RAG_BM25_WEIGHT=0.3

# Максимальное количество чанков контекста для передачи в LLM
RAG_TOP_K=5

# Размер чанка при нарезке документов (в символах)
RAG_CHUNK_SIZE=800

# Перекрытие между чанками (в символах)
RAG_CHUNK_OVERLAP=150

# [CORS Settings]
# Разрешенные origins (JSON-массив или строка с запятыми)
ALLOWED_ORIGINS=["*"]
